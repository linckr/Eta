diff --git a/eta_oneshot.go b/eta_oneshot.go
new file mode 100644
--- /dev/null
+++ b/eta_oneshot.go
@@ -0,0 +1,62 @@
+package main
+
+import (
+	"context"
+	"errors"
+	"net/http"
+	"sync/atomic"
+)
+
+type etaOneShotKey struct{}
+type etaOneShotState struct{ used atomic.Bool }
+
+var errEtaOneShotConsumed = errors.New("one-shot upstream attempt already consumed")
+
+func etaOneShot(r *http.Request) *etaOneShotState {
+	state, _ := r.Context().Value(etaOneShotKey{}).(*etaOneShotState)
+	return state
+}
+
+// The header can only restrict a request, never grant an application-side permit.
+func etaOneShotMiddleware(next http.Handler) http.Handler {
+	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		values := r.Header.Values("X-Eta-One-Shot")
+		if len(values) == 0 {
+			next.ServeHTTP(w, r)
+			return
+		}
+		if len(values) != 1 || values[0] != "v1" {
+			http.Error(w, "Unsupported one-shot contract", http.StatusBadRequest)
+			return
+		}
+		w.Header().Set("X-Eta-One-Shot-Accepted", "v1")
+		next.ServeHTTP(w, r.WithContext(context.WithValue(r.Context(), etaOneShotKey{}, &etaOneShotState{})))
+	})
+}
+
+func etaOneShotDo(client *http.Client, request *http.Request, state *etaOneShotState) (*http.Response, error) {
+	if !state.used.CompareAndSwap(false, true) {
+		return nil, errEtaOneShotConsumed
+	}
+	// Non-replayable POST bodies and a new connection suppress transport-level resend.
+	request.GetBody = nil
+	request.Close = true
+	request.Header.Del("Idempotency-Key")
+	request.Header.Del("X-Idempotency-Key")
+	single := *client
+	transport := client.Transport
+	if transport == nil {
+		transport = http.DefaultTransport
+	}
+	if base, ok := transport.(*http.Transport); ok {
+		strict := base.Clone()
+		strict.DisableKeepAlives = true
+		strict.ForceAttemptHTTP2 = false
+		strict.Protocols = new(http.Protocols)
+		strict.Protocols.SetHTTP1(true)
+		single.Transport = strict
+		defer strict.CloseIdleConnections()
+	}
+	single.CheckRedirect = func(*http.Request, []*http.Request) error { return http.ErrUseLastResponse }
+	return single.Do(request)
+}
