@@ -0,0 +1,143 @@
+package main
+
+import (
+	"bytes"
+	"context"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"sync/atomic"
+	"testing"
+	"time"
+)
+
+func withEtaDecision(path string) *http.Request {
+	r := httptest.NewRequest(http.MethodPost, path, nil)
+	return r.WithContext(context.WithValue(r.Context(), etaOneShotKey{}, &etaOneShotState{}))
+}
+
+func TestEtaOneShotRejectsUnknownHeaderAndSharesSingleState(t *testing.T) {
+	var called int
+	handler := etaOneShotMiddleware(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		called++
+		if etaOneShot(r) == nil {
+			t.Fatal("missing strict context")
+		}
+		if etaOneShot(r.Clone(r.Context())) != etaOneShot(r) {
+			t.Fatal("cloning reset authorization")
+		}
+	}))
+	bad := httptest.NewRequest(http.MethodPost, "/v1/responses", nil)
+	bad.Header.Set("X-Eta-One-Shot", "unknown")
+	w := httptest.NewRecorder()
+	handler.ServeHTTP(w, bad)
+	if w.Code != 400 || called != 0 {
+		t.Fatal("unsupported contract dispatched")
+	}
+	good := httptest.NewRequest(http.MethodPost, "/v1/responses", nil)
+	good.Header.Set("X-Eta-One-Shot", "v1")
+	w = httptest.NewRecorder()
+	handler.ServeHTTP(w, good)
+	if called != 1 || w.Header().Get("X-Eta-One-Shot-Accepted") != "v1" {
+		t.Fatal("contract not acknowledged")
+	}
+}
+
+func TestEtaOneShotNeverRetriesTransientFailure(t *testing.T) {
+	oldClient, oldRetries, oldBackoff := cfg.HttpClient, upstreamTransientRetries, upstreamRetryBackoff
+	defer func() {
+		cfg.HttpClient = oldClient
+		upstreamTransientRetries = oldRetries
+		upstreamRetryBackoff = oldBackoff
+	}()
+	var calls atomic.Int32
+	cfg.HttpClient = &http.Client{Transport: retryTransportFunc(func(r *http.Request) (*http.Response, error) {
+		calls.Add(1)
+		if r.GetBody != nil || !r.Close {
+			t.Fatal("request can be replayed")
+		}
+		return nil, io.EOF
+	})}
+	upstreamTransientRetries = 3
+	upstreamRetryBackoff = time.Millisecond
+	acc := &Account{Auth: &StoredAuth{Edition: "cn", Auth: StoredTokens{AccessToken: "fixture"}}}
+	r := withEtaDecision("/v1/chat/completions")
+	_, _, err := doUpstreamRequest(r, acc, &profileCN, []byte(`{"model":"fixture"}`), 1, "fixture")
+	if err == nil || calls.Load() != 1 {
+		t.Fatalf("calls=%d err=%v", calls.Load(), err)
+	}
+	_, _, _ = doUpstreamRequest(r, acc, &profileCN, []byte(`{"model":"fixture"}`), 1, "fixture")
+	if calls.Load() != 1 {
+		t.Fatal("same inbound request replayed")
+	}
+}
+
+func TestEtaOneShotStatusAndRedirectMatrix(t *testing.T) {
+	for _, path := range []string{"/v1/chat/completions", "/v1/responses", "/v1/messages"} {
+		for _, status := range []int{200, 307, 308, 401, 408, 429, 503} {
+			t.Run(path+"/"+http.StatusText(status), func(t *testing.T) {
+				var calls atomic.Int32
+				server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+					calls.Add(1)
+					w.Header().Set("Location", "/redirect-target")
+					w.WriteHeader(status)
+				}))
+				defer server.Close()
+				req, err := http.NewRequest(http.MethodPost, server.URL+path, bytes.NewReader([]byte(`{"model":"fixture"}`)))
+				if err != nil {
+					t.Fatal(err)
+				}
+				resp, err := etaOneShotDo(server.Client(), req, &etaOneShotState{})
+				if err != nil {
+					t.Fatal(err)
+				}
+				resp.Body.Close()
+				if calls.Load() != 1 || resp.StatusCode != status {
+					t.Fatalf("calls=%d status=%d", calls.Load(), resp.StatusCode)
+				}
+			})
+		}
+	}
+}
+
+func TestEtaOneShotAccountPoolDoesNotFailOver(t *testing.T) {
+	for _, status := range []int{401, 408, 429, 503, 307} {
+		t.Run(http.StatusText(status), func(t *testing.T) {
+			chdirTemp(t)
+			var calls atomic.Int32
+			server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				calls.Add(1)
+				w.Header().Set("Location", "/redirected")
+				w.WriteHeader(status)
+				_, _ = io.WriteString(w, `{"error":{"data":{"code":14018,"msg":"fixture"}}}`)
+			}))
+			defer server.Close()
+			oldBase, oldOrigin, oldClient := profileCN.Base, profileCN.Origin, cfg.HttpClient
+			accountMu.Lock()
+			oldAccounts, oldRR := accounts, rrIndex
+			a := &Account{Path: "fixture-a.json", Auth: &StoredAuth{Edition: "cn", Auth: StoredTokens{AccessToken: "fixture-a", ExpiresAt: time.Now().Add(time.Hour).Unix()}}}
+			b := &Account{Path: "fixture-b.json", Auth: &StoredAuth{Edition: "cn", Auth: StoredTokens{AccessToken: "fixture-b", ExpiresAt: time.Now().Add(time.Hour).Unix()}}}
+			accounts, rrIndex = []*Account{a, b}, 0
+			accountMu.Unlock()
+			profileCN.Base, profileCN.Origin, cfg.HttpClient = server.URL, server.URL, server.Client()
+			defer func() {
+				profileCN.Base, profileCN.Origin, cfg.HttpClient = oldBase, oldOrigin, oldClient
+				accountMu.Lock()
+				accounts, rrIndex = oldAccounts, oldRR
+				accountMu.Unlock()
+			}()
+			req := withEtaDecision("/v1/chat/completions")
+			rec := httptest.NewRecorder()
+			resp, _, _, ok := upstreamChat(rec, req, 1, "fixture", []byte(`{"model":"fixture"}`), time.Now())
+			if resp != nil {
+				resp.Body.Close()
+			}
+			if ok || calls.Load() != 1 {
+				t.Fatalf("ok=%v calls=%d status=%d", ok, calls.Load(), rec.Code)
+			}
+			if a.Auth == nil || b.Auth == nil {
+				t.Fatal("one-shot error invalidated account")
+			}
+		})
+	}
+}
